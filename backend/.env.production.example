# ==============================================================================
# ZeroTask Production Environment Configuration Template (.env.production.example)
# Copy this file to .env.production on the production VPS and populate secrets.
# CRITICAL: DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================================

# 1. APPLICATION CORE SETTINGS
ENVIRONMENT=production
PROJECT_NAME="ZeroTask Production Backend"
API_V1_STR=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# 2. POSTGRESQL 16 PRODUCTION CONFIGURATION
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zerotask
POSTGRES_USER=zerotask_app
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_RANDOM_PASSWORD_32CHARS

# SQLAlchemy Connection Strings (Internal Docker Network)
DATABASE_URL=postgresql+asyncpg://zerotask_app:${POSTGRES_PASSWORD}@postgres:5432/zerotask
DATABASE_SYNC_URL=postgresql://zerotask_app:${POSTGRES_PASSWORD}@postgres:5432/zerotask

# Connection Pool Settings
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# 3. AUTHENTICATION & JWT SECURITY
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_RANDOM_HEX_KEY_MIN_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 4. CORS ORIGINS (Restrict strictly to production client domains)
BACKEND_CORS_ORIGINS=["https://api.zerotask.yourdomain.com","https://zerotask.yourdomain.com"]

# 5. MINIO / S3 PRODUCTION STORAGE
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://api.zerotask.yourdomain.com/storage
# Generate with: openssl rand -hex 16
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY_32CHARS
# Generate with: openssl rand -base64 32
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY_32CHARS
MINIO_USE_SSL=true
MINIO_REGION=us-east-1

# S3 Bucket Names
STORAGE_BUCKET_TASKS=task-attachments
STORAGE_BUCKET_MEETINGS=meeting-attachments
STORAGE_BUCKET_CHAT=chat-attachments
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_VOICE_NOTES=task-audio

# 6. EXTERNAL INTEGRATIONS (OPTIONAL / DEFERRED)
# Google Calendar Sync (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.zerotask.yourdomain.com/api/v1/integrations/google/callback

# Push Notifications (Expo Push Service - Optional)
EXPO_ACCESS_TOKEN=

# Outbound Email (SMTP - Optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@zerotask.yourdomain.com
SMTP_TLS=true

# Meta WhatsApp Cloud API (STATUS: OPTIONAL / DEFERRED)
# WhatsApp is NOT required for core functionality and is disabled by default.
ENABLE_WHATSAPP=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
