# ==============================================================================
# ZEROTASK SELF-HOSTED BACKEND CONFIGURATION (.env.example)
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL
# NEVER EXPOSE PRIVILEGED VALUES (DATABASE PASSWORDS, JWT SECRETS, MINIO KEYS,
# WHATSAPP TOKENS) TO THE MOBILE CLIENT VIA EXPO_PUBLIC_* VARIABLES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="ZeroTask Backend"
API_V1_STR=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zerotask
POSTGRES_USER=zerotask_app
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production
DATABASE_URL=postgresql+asyncpg://zerotask_app:change_this_to_a_secure_password_in_production@postgres:5432/zerotask
DATABASE_SYNC_URL=postgresql://zerotask_app:change_this_to_a_secure_password_in_production@postgres:5432/zerotask

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT CONFIGURATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_64_character_hex_secret_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 4. CORS ORIGINS (Comma-separated list or JSON array)
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","https://zerotask.yourdomain.com"]

# ------------------------------------------------------------------------------
# 5. MINIO / S3 STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin_change_in_production
MINIO_SECRET_KEY=minioadmin_secret_change_in_production
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# Storage Buckets
STORAGE_BUCKET_TASKS=task-attachments
STORAGE_BUCKET_MEETINGS=meeting-attachments
STORAGE_BUCKET_CHAT=chat-attachments
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_AUDIO=task-audio

# ------------------------------------------------------------------------------
# 6. EXPO PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=
ENABLE_PUSH_NOTIFICATIONS=true

# ------------------------------------------------------------------------------
# 7. GOOGLE CALENDAR INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=765817728144-a7ilrgraqpst3f69es6osi4cvij1qq94.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_this_to_google_client_secret
GOOGLE_REDIRECT_URI=https://api.zerotask.yourdomain.com/api/v1/integrations/google-calendar/callback
TOKEN_ENCRYPTION_KEY=change_this_to_a_32_byte_base64_fernet_key_for_db_tokens

# ------------------------------------------------------------------------------
# 8. META WHATSAPP CLOUD API (OPTIONAL / DEFERRED - NOT REQUIRED FOR CORE SCOPE)
# ------------------------------------------------------------------------------
# Core ZeroTask does NOT require WhatsApp. Leave disabled unless explicitly needed.
ENABLE_WHATSAPP=false
# WHATSAPP_ACCESS_TOKEN=change_to_meta_system_user_permanent_token
# WHATSAPP_PHONE_NUMBER_ID=change_to_meta_phone_number_id
# WHATSAPP_BUSINESS_ACCOUNT_ID=change_to_meta_business_account_id
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_to_custom_verify_token
# WHATSAPP_APP_SECRET=change_to_meta_app_secret

# ------------------------------------------------------------------------------
# 9. EMAIL / SMTP (For user invites, password resets)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@zerotask.yourdomain.com
SMTP_PASSWORD=change_this_smtp_password
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@zerotask.yourdomain.com
EMAILS_FROM_NAME="ZeroTask System"
