-- Create ENUMs for roles and request statuses
DO $$ BEGIN
    CREATE TYPE user_role AS ENUM ('Founder', 'Department Head', 'Manager', 'Employee');
EXCEPTION
    WHEN duplicate_object THEN null;
END $$;

DO $$ BEGIN
    CREATE TYPE registration_status AS ENUM ('Pending', 'Approved', 'Rejected');
EXCEPTION
    WHEN duplicate_object THEN null;
END $$;

-- Add role to users if it doesn't exist
DO $$ BEGIN
    ALTER TABLE public.users ADD COLUMN role user_role DEFAULT 'Employee'::user_role;
EXCEPTION
    WHEN duplicate_column THEN null;
END $$;

-- Create registration_requests table
CREATE TABLE IF NOT EXISTS public.registration_requests (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email TEXT NOT NULL UNIQUE,
    requested_role user_role NOT NULL,
    status registration_status NOT NULL DEFAULT 'Pending'::registration_status,
    rejected_at TIMESTAMP WITH TIME ZONE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Enable RLS
ALTER TABLE public.registration_requests ENABLE ROW LEVEL SECURITY;

-- Drop existing policies if re-running
DO $$ BEGIN
    DROP POLICY IF EXISTS "Anyone can insert a registration request via RPC" ON public.registration_requests;
    DROP POLICY IF EXISTS "Managers can view employee requests" ON public.registration_requests;
    DROP POLICY IF EXISTS "Department Heads can view manager and employee requests" ON public.registration_requests;
    DROP POLICY IF EXISTS "Founders can view all requests" ON public.registration_requests;
    DROP POLICY IF EXISTS "Super admins can manage all" ON public.registration_requests;
EXCEPTION
    WHEN undefined_object THEN null;
END $$;

-- RLS Policies for viewing requests
-- Managers can view 'Employee' requests
CREATE POLICY "Managers can view employee requests" 
ON public.registration_requests FOR SELECT 
USING (
  EXISTS (
    SELECT 1 FROM public.users 
    WHERE users.id = auth.uid() AND users.role = 'Manager'
  ) AND requested_role = 'Employee'
);

-- Department Heads can view 'Manager' and 'Employee' requests
CREATE POLICY "Department Heads can view manager and employee requests" 
ON public.registration_requests FOR SELECT 
USING (
  EXISTS (
    SELECT 1 FROM public.users 
    WHERE users.id = auth.uid() AND users.role = 'Department Head'
  ) AND requested_role IN ('Employee', 'Manager')
);

-- Founders can view all requests
CREATE POLICY "Founders can view all requests" 
ON public.registration_requests FOR SELECT 
USING (
  EXISTS (
    SELECT 1 FROM public.users 
    WHERE users.id = auth.uid() AND users.role = 'Founder'
  )
);

-- Note: Updates to this table are performed by the Edge Function using the Service Role key, 
-- bypassing RLS. Therefore, we don't need to add explicit UPDATE policies for users.

-- Create RPC for 24-hour lockout logic
CREATE OR REPLACE FUNCTION submit_registration_request(user_email TEXT, req_role TEXT)
RETURNS json
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
    existing_request RECORD;
BEGIN
    -- Check if there's an existing request for this email
    SELECT * INTO existing_request FROM public.registration_requests WHERE email = user_email;

    IF FOUND THEN
        -- If status is Rejected and rejected_at is within 24 hours, throw lockout error
        IF existing_request.status = 'Rejected' AND existing_request.rejected_at > (NOW() - INTERVAL '24 hours') THEN
            RAISE EXCEPTION 'Email is locked out due to a recent rejection. Please try again later.';
        END IF;

        -- Otherwise, update the existing request to pending
        UPDATE public.registration_requests 
        SET status = 'Pending', requested_role = req_role::user_role, rejected_at = NULL, updated_at = NOW()
        WHERE email = user_email;
    ELSE
        -- Insert a new request
        INSERT INTO public.registration_requests (email, requested_role, status)
        VALUES (user_email, req_role::user_role, 'Pending');
    END IF;

    RETURN json_build_object('success', true);
END;
$$;
