# =============================================================================
# ZeroTask Mobile Environment Configuration (Self-Hosted Architecture)
# =============================================================================

# Self-Hosted FastAPI Backend & WebSocket Endpoints
# Note: For Android Emulator, use 10.0.2.2 instead of localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8088/api/v1
# EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8088/ws
EXPO_PUBLIC_API_URL=http://localhost:8088/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8088/ws
EXPO_PUBLIC_STORAGE_URL=http://localhost:9000

# Third-Party Integrations
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
